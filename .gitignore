.env
*.sqlite
*.sqlite-wal
*.sqlite-shm
.venv/
__pycache__/
data/*.csv
*.pkl
models/
*.safetensors
*.gguf
verity/data/
Verity_Hackathon_Plan.xlsx
# Run outputs over 5 MB (also covered by *.sqlite / *.pkl above)
results/*/verity_data/verity_store.sqlite
results/*/verity_data/embeddings_global.pkl
results/*/verity_data/*/embeddings.pkl
results/*/verity_data/scored_pairs.csv
results/*/band_pairs.csv
# Option C learning curve v2: decisions and model files (regenerate with options/c_learning_curve.py, see lc_v2/README.txt)
results/*/options/c_model/lc_v2/*/decisions.csv
results/*/options/c_model/lc_v2/*/model.txt
results/*/options/c_model/lc_v2/*/calibrator.json
results/*/options/c_model/lc_v2/*/features.json
results/*/options/c_model/lc_v2/*/oof_reliability.json
# Option B answer cache (regenerated by re-running, keyed by pair content); the spending ledger results/llm_ledger.jsonl IS tracked
results/llm_cache/
results/llm_ledger.jsonl.lock
# D's full-band decisions (regenerate with options/d_hybrid.py full) and B's raw call log (the freeze keeps a gzipped copy in its b_archive)
results/**/decisions_fullband*.csv
results/**/sample5000/calls.jsonl
# Rehearsal and D-study runs: generated data, truth and the outputs of 1 MB or more (regenerate from the dev seed)
results/rehearsal_*/orgs_raw*.csv
results/rehearsal_*/options/a_threshold/decisions.csv
results/rehearsal_*/options/c_model/*/decisions.csv
results/rehearsal_*/verity_data/golden_records.csv
results/rehearsal_*/verity_data/match_candidates.csv
results/dstudy_*/orgs_raw*.csv
results/dstudy_*/options/a_threshold/decisions.csv
results/dstudy_*/options/c_model/*/decisions.csv
results/dstudy_*/verity_data/golden_records.csv
results/dstudy_*/verity_data/match_candidates.csv
